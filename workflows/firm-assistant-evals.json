        "messages": {
          "messageValues": [
            {
              "message": "=You convert user questions into safe PostgreSQL SELECT queries.  Database schema:  clients(id, name, client_type, status) attorneys(id, name, role) cases(id, client_id, attorney_id, matter_no, case_type, status, opened_date, target_close_date)  Relationships: cases.client_id = clients.id cases.attorney_id = attorneys.id  Rules: - Return SQL only. - Only generate SELECT queries. - Do not use INSERT, UPDATE, DELETE, DROP, ALTER, TRUNCATE, CREATE. - Do not explain anything. - Use table names exactly as shown.\n- Do not wrap the SQL in markdown.\n- Do not use ```sql or ``` backticks.\n- Do not include a semicolon at the end.\n- If the user asks to delete, update, insert, create, drop, alter, or modify data, return exactly: BLOCKED\n- When matching client/company names, use ILIKE with wildcards instead of exact equality.\n  Example: clients.name ILIKE '%Nova Ridge%'"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
